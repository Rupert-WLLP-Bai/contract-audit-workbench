# Generate a private .env with: python3 deploy/scripts/infra.py bootstrap
# Generated values are local only. Existing .env is never overwritten.
APP_ENV=development
ADDR=127.0.0.1:8080
# Edge upstream health tracking; values are bounded by the gateway configuration.
GATEWAY_HEALTH_INTERVAL=1s
GATEWAY_HEALTH_TIMEOUT=500ms
GATEWAY_HEALTH_FAILURE_THRESHOLD=2
GATEWAY_HEALTH_RECOVERY_THRESHOLD=2
DATA_DIR=var/lib
# Retain history while rejecting business writes; use the current compatible binary.
APP_READ_ONLY=false
# Independent execution: embedded for local convenience, durable for API + Worker.
EXECUTION_MODE=embedded
# Shared complete JSON policy; empty uses drr-v1 (8/2 executing, 256/64 pending).
# All execution/worker replicas must agree; change only after draining active jobs.
EXECUTION_QUEUE_POLICY=
# application uses a separately migrated non-owner role; migrations run via cmd/migrate.
APP_DATABASE_MODE=embedded
DATABASE_SCHEMA=public
MIGRATOR_DATABASE_URL=
# Set true behind an HTTPS reverse proxy; local loopback HTTP uses false.
COOKIE_SECURE=false
# Operator-managed trusted issuer/subject -> tenant/org/grants JSON; never browser claims.
IDENTITY_DIRECTORY_FILE=
# Compose: dedicated host directory containing only identity-directory.json.
# Directory 0750/file 0640, owned by the supplied read group; never mount an env/credentials directory.
IDENTITY_DIRECTORY_ROOT=
IDENTITY_DIRECTORY_GID=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Separate Admin origin callback; empty uses OIDC_REDIRECT_URL for a shared origin.
OIDC_ADMIN_REDIRECT_URL=
# Base64-encoded 32 random bytes shared by API replicas.
OIDC_STATE_KEY=
POSTGRES_IMAGE=postgres:17.9-bookworm
POSTGRES_PORT=5432
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
DEV_DATABASE_URL=postgres://contractaudit:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:5432/contract_audit_dev?sslmode=disable
TEST_DATABASE_URL=postgres://contractaudit:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:5432/contract_audit_test?sslmode=disable
RUSTFS_IMAGE=rustfs/rustfs:1.0.3
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=__GENERATE_RUSTFS_ACCESS_KEY__
RUSTFS_SECRET_KEY=__GENERATE_RUSTFS_SECRET_KEY__
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=contract-audit-dev
S3_REGION=us-east-1
# Empty credentials fall back to the explicitly configured RUSTFS_* pair above.
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWSCLI_IMAGE=amazon/aws-cli:2.31.14
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.0
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE_KEYCLOAK_ADMIN_PASSWORD__
KEYCLOAK_DB_PASSWORD=__GENERATE_KEYCLOAK_DB_PASSWORD__
# S3_ENDPOINT selects mandatory application S3 storage; invalid configuration fails startup.
# Keycloak is an optional local identity provider; OIDC_* selects the application client.
# Optional model endpoint. Deterministic automated acceptance does not call it.
LLM_BASE_URL=http://127.0.0.1:3425/v1
# Both roles use the verified local multimodal model. Replace these env values
# and LLM_BASE_URL for a company provider; no source change is required.
LLM_MODEL=codex/gpt-6-luna
OCR_MODEL=codex/gpt-6-luna
LLM_API_KEY=
# Frozen at review acceptance; mode may be deterministic, fixture, or live.
AGENT_PLANNER_MODE=deterministic
AGENT_PLANNER_MAX_ROUNDS=2
AGENT_PLANNER_MAX_CALLS=16
AGENT_PLANNER_TIMEOUT=30s
AGENT_PLANNER_MAX_EVIDENCE_BYTES=2097152
# Optional metadata-only OTLP/HTTP JSON traces; empty endpoint disables all export.
# This is a collector base URL: /v1/traces is appended. No contract text is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_TRACES_SAMPLER=always_on
# Used only with traceidratio; finite number in [0,1].
OTEL_TRACES_SAMPLER_ARG=1
# Go does not auto-load .env. Bash: set -a; source .env; set +a
# If ports change, also update the URLs above. infra.py checks the database ports agree.

# Client -> Admin URL for split origins; export before Vite dev/build.
# Empty keeps /admin/rulepacks on the same origin. The local cloud launcher supplies port 5175.
VITE_ADMIN_URL=
