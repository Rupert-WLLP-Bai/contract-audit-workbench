# Generate a private .env with: python3 deploy/scripts/infra.py bootstrap
# Generated values are local only. Existing .env is never overwritten.
APP_ENV=development
ADDR=127.0.0.1:8080
# Edge upstream health tracking; values are bounded by the gateway configuration.
GATEWAY_HEALTH_INTERVAL=1s
GATEWAY_HEALTH_TIMEOUT=500ms
GATEWAY_HEALTH_FAILURE_THRESHOLD=2
GATEWAY_HEALTH_RECOVERY_THRESHOLD=2
# Increase both timeouts for long, synchronously parsed documents.
GATEWAY_REQUEST_TIMEOUT=3m
GATEWAY_UPLOAD_TIMEOUT=10m
DATA_DIR=var/lib
# Retain history while rejecting business writes; use the current compatible binary.
APP_READ_ONLY=false
# Independent execution: embedded for local convenience, durable for API + Worker.
EXECUTION_MODE=embedded
# Shared complete JSON policy; empty uses drr-v1 (8/2 executing, 256/64 pending).
# All execution/worker replicas must agree; change only after draining active jobs.
EXECUTION_QUEUE_POLICY=
# Optional independent experience-task delivery; provision one distinct private token for Core and Worker.
CORE_SERVICE_URL=
WORKER_CORE_TOKEN=
# Core-to-Document upload key; app-bootstrap generates a distinct private value.
# It must contain at least 32 bytes and differ from WORKER_DOCUMENT_TOKEN.
CORE_DOCUMENT_TOKEN=
# application uses a separately migrated non-owner role; migrations run via cmd/migrate.
APP_DATABASE_MODE=embedded
DATABASE_SCHEMA=public
MIGRATOR_DATABASE_URL=
# Set true behind an HTTPS reverse proxy; local loopback HTTP uses false.
COOKIE_SECURE=false
# Public browser origins; production does not infer proxy TLS or trust localhost.
# Local distributed profiles generate the web, admin and portal origins.
CORS_ORIGIN=
# Operator-managed trusted issuer/subject -> tenant/org/grants JSON; never browser claims.
IDENTITY_DIRECTORY_FILE=
# Compose: dedicated host directory containing only identity-directory.json.
# Directory 0750/file 0640, owned by the supplied read group; never mount an env/credentials directory.
IDENTITY_DIRECTORY_ROOT=
IDENTITY_DIRECTORY_GID=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Separate Admin origin callback; empty uses OIDC_REDIRECT_URL for a shared origin.
OIDC_ADMIN_REDIRECT_URL=
# Base64-encoded 32 random bytes shared by API replicas.
OIDC_STATE_KEY=
POSTGRES_IMAGE=postgres:18.6-bookworm
# Keycloak 26.4.0 stays on PostgreSQL 17. Do not point this at the business image.
IDENTITY_POSTGRES_IMAGE=postgres:17.9-bookworm
POSTGRES_PORT=5432
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
DEV_DATABASE_URL=postgres://contractaudit:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:5432/contract_audit_dev?sslmode=disable
TEST_DATABASE_URL=postgres://contractaudit:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:5432/contract_audit_test?sslmode=disable
RUSTFS_IMAGE=rustfs/rustfs:1.0.3
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=__GENERATE_RUSTFS_ACCESS_KEY__
RUSTFS_SECRET_KEY=__GENERATE_RUSTFS_SECRET_KEY__
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=contract-audit-dev
S3_REGION=us-east-1
# Empty credentials fall back to the explicitly configured RUSTFS_* pair above.
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWSCLI_IMAGE=amazon/aws-cli:2.31.14
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.0
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE_KEYCLOAK_ADMIN_PASSWORD__
KEYCLOAK_DB_PASSWORD=__GENERATE_KEYCLOAK_DB_PASSWORD__
# S3_ENDPOINT selects mandatory application S3 storage; invalid configuration fails startup.
# Keycloak is an optional local identity provider; OIDC_* selects the application client.
# Optional model endpoint. Deterministic automated acceptance does not call it.
LLM_BASE_URL=http://127.0.0.1:3425/v1
# Both roles use the verified local multimodal model. Replace these env values
# and LLM_BASE_URL for a company provider; no source change is required.
LLM_MODEL=codex/gpt-6-luna
OCR_MODEL=codex/gpt-6-luna
LLM_API_KEY=
# AES-256-GCM key used to seal admin-managed provider credentials. Generate with
# `openssl rand -base64 32`; empty disables saving or opening stored credentials.
# Core uses it for admin probe/readback, the model gateway for dispatch.
LLM_CONFIG_KEY=
# Contract data key for restricted supplier fields (bank account, payee, bank
# name, tax identifier). It seals those values before any draft, receipt or
# frozen snapshot is persisted, and must never reuse LLM_CONFIG_KEY.
# Generate with `openssl rand -base64 32`; empty refuses every operation that
# carries a restricted value instead of storing it in plaintext.
CLM_DATA_KEY=
# Exact hosts (optionally host:port) trusted for admin-managed private model endpoints.
# Empty permits public addresses only; do not add wildcard or CIDR entries.
LLM_ENDPOINT_ALLOWED_HOSTS=
# Signed evidence exports need an operator-provided Ed25519 PKCS#8 PEM and CJK TTF.
# Native mode reads these paths; Compose mounts them read-only in document-service.
# Empty values leave signed export unavailable without affecting other features.
EVIDENCE_SIGNING_KEY_FILE=
EVIDENCE_PDF_FONT_FILE=
# TypeSafe Jev suggestion layer. Deployment profiles enable it explicitly;
# unset means off in code. The key is required only by the model-gateway in
# distributed deployments and is never returned by health or logs. By default
# only minimized knowledge metadata is sent; frozen contract text requires a
# separate approved_text/data-egress approval.
TYPESAFE_JEV_BASE_URL=https://api.typesafe.ai
# Unset means off in code; this deployment profile enables the suggestion layer
# explicitly. The resolver rejects floating aliases such as jev-latest.
TYPESAFE_JEV_MODE=advisory
TYPESAFE_JEV_EGRESS=minimized
TYPESAFE_JEV_FEATURES=knowledge_rerank
TYPESAFE_JEV_MODEL=jev-1.14.0
# model-gateway is the distributed default. direct is development/test only and
# requires the key in the same process.
TYPESAFE_JEV_PROVIDER=model-gateway
TYPESAFE_JEV_TIMEOUT=3s
TYPESAFE_JEV_MAX_CANDIDATES=16
# Keep the real key in the gitignored .env only. This example is tracked, so a
# real value here would be committed to version control. In the distributed
# profile the key belongs to the model-gateway process; workers and the health
# monitor must not receive it.
# TYPESAFE_API_KEY=
# The document and model gateway limits remain bounded and may be raised for large scanned PDFs.
DOCUMENT_PARSE_TIMEOUT=2m
MODEL_MAX_INPUT_TOKEN_RESERVATION=64000
# Optional: configure all three only for a provider-verified single-image token upper bound.
# Empty disables image-specific accounting and keeps the conservative JSON-byte reservation.
MODEL_OCR_IMAGE_PROVIDER_URL=
MODEL_OCR_IMAGE_MODEL=
MODEL_OCR_IMAGE_TOKEN_UPPER_BOUND=
MODEL_TENANT_TOKENS_PER_MINUTE=400000
MODEL_GLOBAL_TOKENS_PER_MINUTE=2000000
MODEL_REQUEST_TIMEOUT=120s
# Frozen at review acceptance; mode may be deterministic, fixture, or live.
AGENT_PLANNER_MODE=deterministic
AGENT_PLANNER_MAX_ROUNDS=2
AGENT_PLANNER_MAX_CALLS=16
AGENT_PLANNER_TIMEOUT=30s
AGENT_PLANNER_MAX_EVIDENCE_BYTES=2097152
# Optional metadata-only OTLP/HTTP JSON. An empty endpoint disables export.
# This is a collector base URL: /v1/traces and /v1/metrics are appended.
# Spans and low-cardinality execution counters are exported. No contract text is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_TRACES_SAMPLER=always_on
# Used only with traceidratio; finite number in [0,1].
OTEL_TRACES_SAMPLER_ARG=1
# The observe overlay is not loaded by default. Compose interpolates every file,
# so GRAFANA_ADMIN_PASSWORD is required only when OBSERVE=1.
# OBSERVE=
# GRAFANA_ADMIN_PASSWORD=
# Go does not auto-load .env. Bash: set -a; source .env; set +a
# If ports change, also update the URLs above. infra.py checks the database ports agree.

# Client -> Admin URL for split origins; export before Vite dev/build.
# Empty keeps /admin/rulepacks on the same origin. The local cloud launcher supplies port 5175.
VITE_ADMIN_URL=

# Operator audit extension. Default off; every extension route returns 503.
# Fixture mode is accepted only in development/test and reads the synthetic
# OSS record under testdata/operatoraudit/. Live mode requires a separate
# approved data-processing path and is not enabled in this release.
OPERATOR_AUDIT_ENABLED=false
EXTERNAL_EVIDENCE_MODE=off
EXTERNAL_EVIDENCE_CONNECTOR_ID=fixture.oss
EXTERNAL_EVIDENCE_SOURCE_SYSTEM=fixture-oss-east
EXTERNAL_EVIDENCE_PAYLOAD_PREFIX=fixture://oss/
# EXTERNAL_EVIDENCE_ALLOWED_OBJECTS=fixture-line-001
# EXTERNAL_EVIDENCE_FIXTURE_FILE=testdata/operatoraudit/raw/oss-bandwidth.json
