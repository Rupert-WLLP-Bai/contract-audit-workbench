        {
          "id": "a",
          "role": "procurement",
          "parse_status": "ready",
          "text": "质保36个月。"
        },
        {
          "id": "b",
          "role": "draft_contract",
          "parse_status": "ready",
          "text": "质保24个月。"
        }
      ],
      "expected_relation": "conflict",
      "expected_evidence": [
